{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Make Your Life Easier",
  "mainBinaryName": "MakeYourLifeEasier",
  "version": "../package.json",
  "identifier": "com.thomasthanos.makeyourlifeeasier",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "url": "splash.html",
        "title": "Make Your Life Easier",
        "width": 300,
        "height": 380,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "backgroundColor": "#0a0c12"
      },
      {
        "label": "main",
        "url": "index.html",
        "title": "Make Your Life Easier",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": false,
    "publisher": "ThomasThanos",
    "copyright": "© 2026 ThomasThanos",
    "category": "Utility",
    "shortDescription": "Make Your Life Easier",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "resources/ludusavi/ludusavi.exe": "ludusavi/ludusavi.exe",
      "resources/ludusavi/manifest.yaml": "ludusavi/manifest.yaml",
      "resources/ludusavi/LICENSE": "ludusavi/LICENSE",
      "resources/ludusavi/THIRD-PARTY-NOTICES.txt": "ludusavi/THIRD-PARTY-NOTICES.txt",
      "resources/spicetify/placeholder-theme/color.ini": "spicetify/placeholder-theme/color.ini",
      "resources/spicetify/placeholder-theme/user.css": "spicetify/placeholder-theme/user.css",
      "resources/spicetify/MIT-NOTICE.txt": "spicetify/MIT-NOTICE.txt"
    }
  }
}
